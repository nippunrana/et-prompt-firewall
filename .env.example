# Copy to .env. Every key is optional: without them the firewall runs its rules, classifiers and language
# gate only (each answer says so), and the agent demo is off.

# The LLM judge (Gemma 4 31B on the Gemini API). A free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The sandbox and the demo agent's model (Qwen3-next-80B instruct on OpenRouter): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Only to build the firewall image yourself: a Hugging Face read token, after accepting the licence at
# https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M
HF_TOKEN=
